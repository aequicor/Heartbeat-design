                },
                {
                  "type": "frame",
                  "id": "bgGsO",
                  "name": "Агент / поверхность сообщения",
                  "context": "Один ход — одно облачко. Ход работы доступен в обычной истории, а не только в отдельном демонстрационном кадре. Подтверждённый финал однократно закрывает историю; пользователь может повторно раскрыть этап, инструменты и предоставленный движком Thinking. В макете используются демонстрационные события. Короткое подтверждение без событий остаётся обычной репликой.",
                  "clip": true,
                  "width": "fill_container",
                  "fill": "$aurora.pearl",
