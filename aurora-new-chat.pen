                          "fontSize": 16
                        },
                        {
                          "type": "frame",
                          "id": "Y3VAPg",
                          "name": "Футер / время справа / ширина по содержимому",
                          "context": "Статический образец: время у правого края на базовой линии последней строки. В приложении положение вычисляется по фактической раскладке; зазор не меньше 8 dp. plans/aurora-message-space.md",
                          "width": "fill_container",
